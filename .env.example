# ========================================================
# COFIX ENVIRONMENT VARIABLES
# ========================================================

# 1. SUPABASE INTEGRATION (Frontend Client)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 2. MIDTRANS PAYMENT GATEWAY (Server-Side)
# Dapatkan dari Midtrans Dashboard -> Settings -> Access Keys
# JANGAN PERNAH menaruh Server Key ini di frontend atau repository publik!
MIDTRANS_SERVER_KEY="SB-Mid-server-yourServerKey"
MIDTRANS_CLIENT_KEY="SB-Mid-client-yourClientKey"
MIDTRANS_IS_PRODUCTION="false"

# 3. FONNTE WHATSAPP GATEWAY (Server-Side)
# Dapatkan dari https://fonnte.com -> Dashboard -> Device -> API Token
# Notifikasi WhatsApp pesanan baru otomatis dikirim ke nomor HP yang tersimpan pada akun Admin!
FONNTE_TOKEN="your_fonnte_device_token"

# 4. SERVER CONFIGURATION
PORT="3000"
NODE_ENV="development"
